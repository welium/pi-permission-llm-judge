{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "#src/*": ["./src/*"],
      "#test/*": ["./test/*"]
    }
  },
  "include": ["src", "test"]
}
